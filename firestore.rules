rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public curriculum resources - readable by all students & instructors
    match /units/{unitId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /topics/{topicId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /notes/{noteId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /mcqs/{mcqId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // User Profile
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || !isAuthenticated();

      match /quizAttempts/{attemptId} {
        allow read: if isOwner(userId) || !isAuthenticated();
        allow create: if isOwner(userId) || !isAuthenticated();
        allow update, delete: if isOwner(userId);
      }
    }

    // Health check test path
    match /test/connection {
      allow read: if true;
      allow write: if true;
    }
  }
}
